# Clerk SSO (Question 3)
# https://dashboard.clerk.com — use pk_test_/sk_test_ locally, pk_live_/sk_live_ in prod.
# NEXT_PUBLIC_* must be available at Docker *build* time (see Dockerfile ARG).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults used in code)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Production only (Coolify). Leave EMPTY locally so Development keys use accounts.dev.
# Relative path loads clerk.browser.js via our domain (valid TLS) instead of clerk.*.duckdns.org.
# Also set the same URL in Clerk Dashboard → Domains → Frontend API → Set proxy configuration
# as the absolute URL: https://hello-pomelo.duckdns.org/__clerk
NEXT_PUBLIC_CLERK_PROXY_URL=
